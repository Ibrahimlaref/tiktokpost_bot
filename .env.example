# =============================================================================
# Islamic Stories Bot — Environment Variables
# Copy this file to .env and fill in your actual credentials.
# =============================================================================

# --- LLM Provider (pick one) ---
OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
LLM_PROVIDER=openai          # "openai" or "anthropic"
LLM_MODEL=gpt-4o             # Model name for narration writing

# --- Hadith Source ---
# Sunnah.com API key (request via https://github.com/sunnah-com/api)
# Leave blank to use fawazahmed0/hadith-api fallback (free, no key needed)
SUNNAH_API_KEY=

# --- TTS (ElevenLabs) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=         # Voice ID for narration

# --- TikTok Content Posting API ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_REDIRECT_URI=https://localhost/callback

# --- Optional: Image Generation ---
# OPENAI_IMAGE_API_KEY=       # For DALL-E backgrounds (optional)
# STABILITY_API_KEY=          # For Stability AI backgrounds (optional)

# --- Paths ---
OUTPUT_DIR=output
DATA_DIR=data
ASSETS_DIR=assets
